<%- include('layouts/header', { title: 'Complete Your Profile' }) %>
<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4">Complete Your Profile</h2>
        <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <form action="/user-info" method="POST">
            <div class="mb-3">
                <label for="height" class="form-label">Height (in cm)</label>
                <input type="number" class="form-control" id="height" name="height"
                       value="<%= profile ? profile.height : '' %>" required>
            </div>
            <div class="mb-3">
                <label for="weight" class="form-label">Weight (in kg)</label>
                <input type="number" class="form-control" id="weight" name="weight"
                       value="<%= profile ? profile.weight : '' %>" required>
            </div>
            <div class="mb-3">
                <label for="age" class="form-label">Age</label>
                <input type="number" class="form-control" id="age" name="age"
                       value="<%= profile ? profile.age : '' %>" required>
            </div>
            <div class="mb-3">
                <label for="goal" class="form-label">Fitness Goal</label>
                <select class="form-control" id="goal" name="goal" required>
                    <option value="weight_loss" <%= profile && profile.goal === 'weight_loss' ? 'selected' : '' %>>Lose Weight</option>
                    <option value="muscle_gain" <%= profile && profile.goal === 'muscle_gain' ? 'selected' : '' %>>Build Muscle</option>
                    <option value="maintenance" <%= profile && profile.goal === 'maintenance' ? 'selected' : '' %>>Maintain Weight</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Submit</button>
        </form>
    </div>
</div>
<%- include('layouts/footer') %>