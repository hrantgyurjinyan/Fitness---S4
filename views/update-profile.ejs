<%- include('layouts/header', { title: 'Update Profile' }) %>

<div class="container mt-5">
    <h1>Update Your Profile</h1>

    <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/update-profile" method="POST">
        <div class="mb-3">
            <label for="age" class="form-label">Age</label>
            <input type="number" class="form-control" id="age" name="age"
                   value="<%= typeof profile !== 'undefined' ? profile.age : '' %>" required>
        </div>

        <div class="mb-3">
            <label for="height" class="form-label">Height (cm)</label>
            <input type="number" class="form-control" id="height" name="height"
                   value="<%= typeof profile !== 'undefined' ? profile.height : '' %>" required>
        </div>

        <div class="mb-3">
            <label for="weight" class="form-label">Weight (kg)</label>
            <input type="number" class="form-control" id="weight" name="weight"
                   value="<%= typeof profile !== 'undefined' ? profile.weight : '' %>" required>
        </div>

        <div class="mb-3">
            <label for="goal" class="form-label">Goal</label>
            <select class="form-control" id="goal" name="goal" required>
                <option value="weight_loss" <%= profile && profile.goal === 'weight_loss' ? 'selected' : '' %>>Lose Weight</option>
                <option value="muscle_gain" <%= profile && profile.goal === 'muscle_gain' ? 'selected' : '' %>>Build Muscle</option>
                <option value="maintenance" <%= profile && profile.goal === 'maintenance' ? 'selected' : '' %>>Maintain Weight</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Update</button>
    </form>

    <a href="/dashboard" class="btn btn-secondary mt-3">Back to Dashboard</a>
</div>

<%- include('layouts/footer') %>