<!--
<%- include('layouts/header', { title: 'Nutrition Plan' }) %>

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-success text-white">
            <h3><%= nutritionPlan.title %></h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h4>Macronutrient Targets</h4>
                    <ul class="list-group mb-4">
                        <li class="list-group-item">
                            <strong>Daily Calories:</strong> <%= nutritionPlan.daily_calories %>
                        </li>
                        <li class="list-group-item">
                            <strong>Protein:</strong> <%= nutritionPlan.protein_goal %>
                        </li>
                        <li class="list-group-item">
                            <strong>Carbohydrates:</strong> <%= nutritionPlan.carb_goal %>
                        </li>
                        <li class="list-group-item">
                            <strong>Fats:</strong> <%= nutritionPlan.fat_goal %>
                        </li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <h4>Meal Timing</h4>
                    <div class="card bg-light">
                        <div class="card-body">
                            <p>Pre-Workout: 30g carbs + 15g protein</p>
                            <p>Post-Workout: 40g carbs + 25g protein</p>
                            <p>Space meals 3-4 hours apart</p>
                        </div>
                    </div>
                </div>
            </div>

            <h4 class="mt-4">Sample Meal Plan</h4>
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead class="table-dark">
                    <tr>
                        <th>Meal</th>
                        <th>Example</th>
                        <th>Macros</th>
                    </tr>
                    </thead>
                    <tbody>
                    <% JSON.parse(nutritionPlan.meal_examples).forEach(meal => { %>
                    <tr>
                        <td><%= meal.split(':')[0] %></td>
                        <td><%= meal.split(':')[1] %></td>
                        <td>Approx. 500 kcal</td>
                    </tr>
                    <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('layouts/footer') %>-->
